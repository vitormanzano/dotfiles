# Font
font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = -liga,-calt

# Cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

# Window
confirm-close-surface = false
window-padding-balance = false
# 0.87
background-opacity = 0.80
window-save-state = never
resize-overlay = never
window-decoration = none
unfocused-split-opacity = 1

# theme = Carbonfox

# Keybindings
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard
keybind = shift+enter=text:\x1b\r

# vi: ft=ini
# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# One dark Theme
foreground = 979eab
background = 282c34
cursor-color = cccccc
selection-foreground = 282c34
selection-background = 979eab
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#be5046
palette = 6=#56b6c2
palette = 7=#979eab
palette = 8=#393e48
palette = 9=#d19a66
palette = 10=#56b6c2
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#be5046
palette = 14=#56b6c2
palette = 15=#abb2bf
